# Runtime
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Local persistence for presentation prototype
DATABASE_URL=sqlite:///./data/local/claimvision.db
UPLOAD_DIR=./data/local/uploads
REPORT_DIR=./artifacts/reports

# Model artifacts: local paths, never credentials
FRAUD_MODEL_PATH=./artifacts/models/fraud/model.onnx
SEVERITY_MODEL_PATH=./artifacts/models/severity/model.onnx
DAMAGE_DETECTOR_PATH=./artifacts/models/damage/best.pt
PART_DETECTOR_PATH=./artifacts/models/parts/best.pt
MODEL_REGISTRY_PATH=./artifacts/models/registry.json

# Inference
INFERENCE_DEVICE=cpu
MAX_UPLOAD_MB=15
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ENABLE_EXPLAINABILITY=true

# Optional demonstration flags
ENABLE_DEMO_FIXTURES=false
ENABLE_API_DOCS=true

# Never put real keys in this example.

